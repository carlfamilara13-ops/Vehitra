# Used ONLY by `npm run test:db:cloud`. Copy to .env.test (git-ignored). DEV Supabase project ONLY.
VEHITRA_DB_ENV=dev
# Supabase dashboard -> Connect -> direct connection / session pooler string of the DEV project
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-DEV-REF.supabase.co:5432/postgres
# Optional safety: host of the production DB; the tests refuse to run if the URL contains it
VEHITRA_PROD_DB_HOST=
